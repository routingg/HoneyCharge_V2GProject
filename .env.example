# Gemini (Google GenAI) — HoneyCharge mobility-context AI layer.
# The system runs correctly with these unset/false: it falls back to a
# deterministic historical predictor (see lib/services/ai/fallback.ts).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=false
GEMINI_TIMEOUT_MS=8000

# Korea Meteorological Administration API key used by the existing grid
# dashboard's short-term forecast (worker/index.ts). Optional — falls back
# to synthetic weather when unset.
KMA_SERVICE_KEY=
